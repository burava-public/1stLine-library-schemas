{
  "fields": [
    {
      "name": "channel",
      "type": "string"
    },
    {
      "name": "ts",
      "type": "string"
    },
    {
      "name": "attachments",
      "type": "array",
      "description": "Slack attachment payload generated by Zabbix media_slack template"
    },
    {
      "name": "attachments[0].fallback",
      "type": "string"
    },
    {
      "name": "attachments[0].title",
      "type": "string"
    },
    {
      "name": "attachments[0].color",
      "type": "string"
    },
    {
      "name": "attachments[0].title_link",
      "type": "string"
    },
    {
      "name": "attachments[0].text",
      "type": "string"
    },
    {
      "name": "attachments[0].actions",
      "type": "array"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Alert title"
    },
    {
      "name": "status",
      "type": "string",
      "description": "Problem lifecycle status extracted from title"
    },
    {
      "name": "summary",
      "type": "string",
      "description": "Problem summary"
    },
    {
      "name": "message",
      "type": "string",
      "description": "Full alert message body"
    },
    {
      "name": "description",
      "type": "string",
      "description": "Alert description"
    },
    {
      "name": "priority",
      "type": "string",
      "description": "Severity from Zabbix message content"
    },
    {
      "name": "value",
      "type": "string",
      "description": "Operational data value from message content"
    },
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "source",
      "type": "string",
      "description": "Zabbix event deep-link"
    },
    {
      "name": "labels",
      "type": "dictionary",
      "description": "Dynamic labels parsed from key-value lines in message body"
    },
    {
      "name": "labels.*",
      "type": "string"
    }
  ],
  "sample": {
    "channel": "#oncall",
    "attachments": [
      {
        "fallback": "Problem: CPU utilization too high on checkout-api",
        "title": "Problem: CPU utilization too high on checkout-api",
        "color": "#E97659",
        "title_link": "https://zabbix.example.com/tr_events.php?triggerid=24680&eventid=13579",
        "text": "Problem started at 15:14:31 on 2026-05-14\nProblem name: CPU utilization too high on checkout-api\nHost: checkout-api-01\nSeverity: High\nOperational data: avg cpu=93.2%\nOriginal problem ID: 13579\nhttps://runbooks.example.com/checkout/cpu",
        "actions": [
          {
            "type": "button",
            "text": "Open in Zabbix",
            "url": "https://zabbix.example.com/tr_events.php?triggerid=24680&eventid=13579"
          }
        ]
      }
    ]
  },
  "patterns": [
    {
      "name": "title",
      "type": "string",
      "sourceField": "attachments.0.title",
      "saveIntermediate": false
    },
    {
      "name": "status",
      "type": "string",
      "description": "Lifecycle status in title",
      "sourceField": "attachments.0.title",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "i",
          "pattern": "^(?<extract>Problem|Resolved|Updated|Discovery|Autoregistration|Service)"
        }
      }
    },
    {
      "name": "summary",
      "type": "string",
      "description": "Problem name line from alert text",
      "sourceField": "attachments.0.text",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^Problem name:\\s*(?<extract>[^\\n]+)"
        }
      },
      "fallbacks": [
        {
          "type": "string",
          "description": "Fallback summary from title",
          "sourceField": "attachments.0.title",
          "sourcePattern": {
            "type": "regex",
            "config": {
              "flags": "s",
              "pattern": "^[^:]+:\\s*(?<extract>.+)$"
            }
          }
        }
      ]
    },
    {
      "name": "message",
      "type": "string",
      "sourceField": "attachments.0.text"
    },
    {
      "name": "description",
      "type": "string",
      "sourceField": "attachments.0.text"
    },
    {
      "name": "priority",
      "type": "string",
      "sourceField": "attachments.0.text",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^Severity:\\s*(?<extract>[^\\n]+)"
        }
      }
    },
    {
      "name": "value",
      "type": "string",
      "sourceField": "attachments.0.text",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^Operational data:\\s*(?<extract>[^\\n]+)"
        }
      }
    },
    {
      "name": "event_id",
      "type": "string",
      "sourceField": "attachments.0.text",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^Original problem ID:\\s*(?<extract>\\d+)"
        }
      }
    },
    {
      "name": "source",
      "type": "string",
      "sourceField": "attachments.0.title_link"
    },
    {
      "name": "labels",
      "type": "dictionary",
      "description": "Key-value lines from message body",
      "hasChildren": true,
      "sourceField": "attachments.0.text",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "s",
          "pattern": "(?<extract>.*)"
        }
      },
      "dictionary": {
        "type": "string",
        "sourcePattern": {
          "type": "keyPairRegex",
          "config": {
            "flags": "gm",
            "extractAll": true,
            "trimValues": true,
            "pattern": "^\\s*(?<key>[A-Za-z][A-Za-z0-9 _-]{1,60}):\\s(?<value>.+?)\\s*$"
          }
        }
      },
      "fallbacks": [
        {
          "type": "dictionary",
          "description": "Fallback labels parsed from incident labels passthrough JSON",
          "hasChildren": true,
          "sourceField": "incident_labels_json",
          "sourcePattern": {
            "type": "split",
            "config": {
              "delimiter": "__NO_SPLIT_SENTINEL__"
            }
          },
          "dictionary": {
            "type": "string",
            "sourcePattern": {
              "type": "json_extract",
              "config": {
                "jsonPath": "$.*",
                "parseAsJson": true
              }
            }
          },
          "saveIntermediate": false
        }
      ]
    }
  ],
  "ack_mapping": {
    "title": "title",
    "description": "attachments[0].text",
    "ack_link": "attachments[0].title_link",
    "unack_link": "source",
    "fallback_title": "attachments[0].fallback",
    "overrides": {
      "attachments[0].color": "#6495ED"
    }
  },
  "allow_guest_ack": true,
  "resolution_patterns": [
    {
      "name": "status",
      "type": "string",
      "description": "Resolved state from title",
      "sourceField": "attachments.0.title",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "i",
          "pattern": "^(?<extract>Resolved)"
        }
      }
    }
  ],
  "resolution_mapping": {
    "title": "title",
    "description": "description",
    "status": "status",
    "overrides": {
      "attachments[0].color": "#009900"
    },
    "fallback_title": "attachments[0].fallback",
    "resolve_link": "labels.__alert_resolve_link__"
  },
  "incident_lifecycle_mapping": {
    "created": {
      "title": "title",
      "description": "description",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": true,
      "overrides": {
        "priority": "${priority}",
        "attachments[0].color": "#D63232",
        "labels.created_by_name": "${incident.created_by_name}",
        "labels.created_by_email": "${incident.created_by_email}",
        "labels.created_at": "${incident.created_at}",
        "attachments[0].fallback": "${incident.title}",
        "incident_labels_json": "${labels}"
      }
    },
    "reopened": {
      "title": "title",
      "description": "",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": true,
      "overrides": {
        "priority": "${priority}",
        "attachments[0].color": "#D63232",
        "attachments[0].text": "Priority: ${incident.priority}\n${incident.event.actor_name} ${incident.event.action} incident from ${incident.event.from_status} to ${incident.event.to_status}\nDescription: ${incident.description}\nCreated: ${incident.created_at}; Started: ${incident.started_at}; Detected: ${incident.detected_at}\nResolved at: ${incident.resolved_at}\nMTTR: ${incident.metrics.mttr_seconds} seconds; Overriden: ${incident.metrics.mttr_is_overridden}; Note: ${incident.metrics.mttr_override_note}\nIncident Uid: ${incident.uid}\nCreated by: ${incident.created_by_name} (${incident.created_by_email})",
        "attachments[0].fallback": "${incident.event.to_status} - ${incident.priority} ${incident.title}",
        "incident_labels_json": "${labels}"
      }
    },
    "resolved": {
      "title": "title",
      "description": "",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": false,
      "overrides": {
        "attachments[0].color": "#33cc33",
        "attachments[0].text": "Priority: ${incident.priority}\n${incident.event.actor_name} ${incident.event.action} incident from ${incident.event.from_status} to ${incident.event.to_status}\nDescription: ${incident.description}\nCreated: ${incident.created_at}; Started: ${incident.started_at}; Detected: ${incident.detected_at}\nResolved at: ${incident.resolved_at}\nMTTR: ${incident.metrics.mttr_seconds} seconds; Overriden: ${incident.metrics.mttr_is_overridden}; Note: ${incident.metrics.mttr_override_note}\nIncident Uid: ${incident.uid}\nCreated by: ${incident.created_by_name} (${incident.created_by_email})",
        "attachments[0].fallback": "${incident.event.to_status} - ${incident.priority} ${incident.title}"
      }
    },
    "closed": {
      "title": "title",
      "description": "",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": false,
      "overrides": {
        "attachments[0].text": "Priority: ${incident.priority}\n${incident.event.actor_name} ${incident.event.action} incident from ${incident.event.from_status} to ${incident.event.to_status}\nDescription: ${incident.description}\nCreated: ${incident.created_at}; Started: ${incident.started_at}; Detected: ${incident.detected_at}\nResolved at: ${incident.resolved_at}\nClosed at: ${incident.closed_at}\nMTTR: ${incident.metrics.mttr_seconds} seconds; Overriden: ${incident.metrics.mttr_is_overridden}; Note: ${incident.metrics.mttr_override_note}\nIncident Uid: ${incident.uid}\nCreated by: ${incident.created_by_name} (${incident.created_by_email})",
        "attachments[0].color": "#808080",
        "attachments[0].fallback": "${incident.event.to_status} - ${incident.priority} ${incident.title}"
      }
    },
    "priority_changed": {
      "title": "title",
      "description": "",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": false,
      "overrides": {
        "priority": "${incident.priority}",
        "attachments[0].color": "#DAC17C",
        "attachments[0].text": "Priority: ${incident.priority}\n${incident.event.actor_name} ${incident.event.action} incident from ${incident.event.from_status} to ${incident.event.to_status}\nDescription: ${incident.description}\nCreated: ${incident.created_at}; Started: ${incident.started_at}; Detected: ${incident.detected_at}\nResolved at: ${incident.resolved_at}\nClosed at: ${incident.closed_at}\nMTTR: ${incident.metrics.mttr_seconds} seconds; Overriden: ${incident.metrics.mttr_is_overridden}; Note: ${incident.metrics.mttr_override_note}\nIncident Uid: ${incident.uid}\nCreated by: ${incident.created_by_name} (${incident.created_by_email})",
        "attachments[0].fallback": "${incident.event.to_status} - ${incident.priority} ${incident.title}"
      }
    }
  },
  "resolution_proxy_config": "1stLine",
  "proxy_recurrent_alerts": false,
  "fingerprint_fields": [
    "channel",
    "event_id",
    "title",
    "status"
  ],
  "default_forward_to": null
}
