{
  "fields": [
    {
      "name": "embeds",
      "type": "array"
    },
    {
      "name": "embeds[0].color",
      "type": "number"
    },
    {
      "name": "embeds[0].url",
      "type": "string"
    },
    {
      "name": "embeds[0].title",
      "type": "string"
    },
    {
      "name": "embeds[0].description",
      "type": "string"
    },
    {
      "name": "title",
      "type": "string"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "summary",
      "type": "string"
    },
    {
      "name": "message",
      "type": "string"
    },
    {
      "name": "description",
      "type": "string"
    },
    {
      "name": "priority",
      "type": "string"
    },
    {
      "name": "value",
      "type": "string"
    },
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "source",
      "type": "string"
    },
    {
      "name": "labels",
      "type": "dictionary"
    },
    {
      "name": "labels.*",
      "type": "string"
    }
  ],
  "sample": {
    "embeds": [
      {
        "color": 15328857,
        "url": "https://zabbix.example.com/tr_events.php?triggerid=24680&eventid=13579",
        "title": "Problem: CPU utilization too high on checkout-api",
        "description": "Problem started at 15:14:31 on 2026-05-14\nProblem name: CPU utilization too high on checkout-api\nHost: checkout-api-01\nSeverity: High\nOperational data: avg cpu=93.2%\nOriginal problem ID: 13579\nhttps://runbooks.example.com/checkout/cpu"
      }
    ]
  },
  "patterns": [
    {
      "name": "title",
      "type": "string",
      "sourceField": "embeds.0.title"
    },
    {
      "name": "status",
      "type": "string",
      "sourceField": "embeds.0.title",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "i",
          "pattern": "^(?<extract>Problem|Resolved|Updated|Discovery|Autoregistration|Service)"
        }
      }
    },
    {
      "name": "summary",
      "type": "string",
      "sourceField": "embeds.0.description",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^Problem name:\\s*(?<extract>[^\\n]+)"
        }
      },
      "fallbacks": [
        {
          "type": "string",
          "sourceField": "embeds.0.title",
          "sourcePattern": {
            "type": "regex",
            "config": {
              "flags": "s",
              "pattern": "^[^:]+:\\s*(?<extract>.+)$"
            }
          }
        }
      ]
    },
    {
      "name": "message",
      "type": "string",
      "sourceField": "embeds.0.description"
    },
    {
      "name": "description",
      "type": "string",
      "sourceField": "embeds.0.description"
    },
    {
      "name": "priority",
      "type": "string",
      "sourceField": "embeds.0.description",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^Severity:\\s*(?<extract>[^\\n]+)"
        }
      }
    },
    {
      "name": "value",
      "type": "string",
      "sourceField": "embeds.0.description",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^Operational data:\\s*(?<extract>[^\\n]+)"
        }
      }
    },
    {
      "name": "event_id",
      "type": "string",
      "sourceField": "embeds.0.description",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^Original problem ID:\\s*(?<extract>\\d+)"
        }
      }
    },
    {
      "name": "source",
      "type": "string",
      "sourceField": "embeds.0.url"
    },
    {
      "name": "labels",
      "type": "dictionary",
      "hasChildren": true,
      "sourceField": "embeds.0.description",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "s",
          "pattern": "(?<extract>.*)"
        }
      },
      "dictionary": {
        "type": "string",
        "sourcePattern": {
          "type": "keyPairRegex",
          "config": {
            "flags": "gm",
            "extractAll": true,
            "trimValues": true,
            "pattern": "^\\s*(?<key>[A-Za-z][A-Za-z0-9 _-]{1,60}):\\s(?<value>.+?)\\s*$"
          }
        }
      },
      "fallbacks": [
        {
          "type": "dictionary",
          "description": "Fallback labels parsed from incident labels passthrough JSON",
          "hasChildren": true,
          "sourceField": "incident_labels_json",
          "sourcePattern": {
            "type": "split",
            "config": {
              "delimiter": "__NO_SPLIT_SENTINEL__"
            }
          },
          "dictionary": {
            "type": "string",
            "sourcePattern": {
              "type": "json_extract",
              "config": {
                "jsonPath": "$.*",
                "parseAsJson": true
              }
            }
          },
          "saveIntermediate": false
        }
      ]
    }
  ],
  "ack_mapping": {
    "title": "title",
    "description": "description",
    "ack_link": "source",
    "unack_link": "source",
    "overrides": {
      "embeds[0].color": "6591981"
    }
  },
  "allow_guest_ack": true,
  "resolution_patterns": [
    {
      "name": "status",
      "type": "string",
      "sourceField": "embeds.0.title",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "i",
          "pattern": "^(?<extract>Resolved)"
        }
      }
    }
  ],
  "resolution_mapping": {
    "title": "title",
    "description": "description",
    "status": "status",
    "overrides": {
      "embeds[0].color": "39168"
    },
    "resolve_link": "labels.__alert_resolve_link__"
  },
  "incident_lifecycle_mapping": {
    "created": {
      "title": "title",
      "description": "description",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": true,
      "overrides": {
        "priority": "${priority}",
        "embeds[0].color": "14037554",
        "labels.created_by_name": "${incident.created_by_name}",
        "labels.created_by_email": "${incident.created_by_email}",
        "labels.created_at": "${incident.created_at}",
        "incident_labels_json": "${labels}"
      }
    },
    "reopened": {
      "title": "title",
      "description": "",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": true,
      "overrides": {
        "priority": "${priority}",
        "embeds[0].color": "14037554",
        "embeds[0].description": "Priority: ${incident.priority}\n${incident.event.actor_name} ${incident.event.action} incident from ${incident.event.from_status} to ${incident.event.to_status}\nDescription: ${incident.description}\nCreated: ${incident.created_at}; Started: ${incident.started_at}; Detected: ${incident.detected_at}\nResolved at: ${incident.resolved_at}\nMTTR: ${incident.metrics.mttr_seconds} seconds; Overriden: ${incident.metrics.mttr_is_overridden}; Note: ${incident.metrics.mttr_override_note}\nIncident Uid: ${incident.uid}\nCreated by: ${incident.created_by_name} (${incident.created_by_email})",
        "incident_labels_json": "${labels}"
      }
    },
    "resolved": {
      "title": "title",
      "description": "",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": false,
      "overrides": {
        "embeds[0].color": "3581519",
        "embeds[0].description": "Priority: ${incident.priority}\n${incident.event.actor_name} ${incident.event.action} incident from ${incident.event.from_status} to ${incident.event.to_status}\nDescription: ${incident.description}\nCreated: ${incident.created_at}; Started: ${incident.started_at}; Detected: ${incident.detected_at}\nResolved at: ${incident.resolved_at}\nMTTR: ${incident.metrics.mttr_seconds} seconds; Overriden: ${incident.metrics.mttr_is_overridden}; Note: ${incident.metrics.mttr_override_note}\nIncident Uid: ${incident.uid}\nCreated by: ${incident.created_by_name} (${incident.created_by_email})"
      }
    },
    "closed": {
      "title": "title",
      "description": "",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": false,
      "overrides": {
        "embeds[0].description": "Priority: ${incident.priority}\n${incident.event.actor_name} ${incident.event.action} incident from ${incident.event.from_status} to ${incident.event.to_status}\nDescription: ${incident.description}\nCreated: ${incident.created_at}; Started: ${incident.started_at}; Detected: ${incident.detected_at}\nResolved at: ${incident.resolved_at}\nClosed at: ${incident.closed_at}\nMTTR: ${incident.metrics.mttr_seconds} seconds; Overriden: ${incident.metrics.mttr_is_overridden}; Note: ${incident.metrics.mttr_override_note}\nIncident Uid: ${incident.uid}\nCreated by: ${incident.created_by_name} (${incident.created_by_email})",
        "embeds[0].color": "8421504"
      }
    },
    "priority_changed": {
      "title": "title",
      "description": "",
      "status": "",
      "incident_link": "source",
      "send_alert": true,
      "register_alert": false,
      "overrides": {
        "priority": "${incident.priority}",
        "embeds[0].color": "14336380",
        "embeds[0].description": "Priority: ${incident.priority}\n${incident.event.actor_name} ${incident.event.action} incident from ${incident.event.from_status} to ${incident.event.to_status}\nDescription: ${incident.description}\nCreated: ${incident.created_at}; Started: ${incident.started_at}; Detected: ${incident.detected_at}\nResolved at: ${incident.resolved_at}\nClosed at: ${incident.closed_at}\nMTTR: ${incident.metrics.mttr_seconds} seconds; Overriden: ${incident.metrics.mttr_is_overridden}; Note: ${incident.metrics.mttr_override_note}\nIncident Uid: ${incident.uid}\nCreated by: ${incident.created_by_name} (${incident.created_by_email})"
      }
    }
  },
  "ai_escalation_mapping": {
    "enabled": true,
    "title": "embeds[0].title",
    "message": "embeds[0].description",
    "assignment_link": "embeds[0].url"
  },
  "resolution_proxy_config": "1stLine",
  "proxy_recurrent_alerts": false,
  "ai_override_forward_to": null,
  "fingerprint_fields": [
    "event_id",
    "title",
    "status"
  ],
  "default_forward_to": null
}
