{
  "fields": [
    {
      "name": "username",
      "type": "string",
      "description": "Slack username"
    },
    {
      "name": "attachments",
      "type": "array",
      "description": "Array with 1 items"
    },
    {
      "name": "attachments[0].title",
      "type": "string",
      "description": "Slack attachment title"
    },
    {
      "name": "attachments[0].title_link",
      "type": "string",
      "description": "Slack attachment title link"
    },
    {
      "name": "attachments[0].text",
      "type": "string",
      "description": "Slack attachment text"
    },
    {
      "name": "attachments[0].fallback",
      "type": "string",
      "description": "Slack attachment fallback text"
    },
    {
      "name": "attachments[0].footer",
      "type": "string",
      "description": "Slack attachment footer"
    },
    {
      "name": "attachments[0].color",
      "type": "string",
      "description": "Slack attachment color"
    },
    {
      "name": "attachments[0].ts",
      "type": "number",
      "description": "Slack attachment timestamp"
    },
    {
      "name": "incident_uid",
      "type": "string",
      "description": "Internal incident UID used as the fingerprint source",
      "defaultValue": "incident-9f1b9a2e-3d42-4c1e-8e15-4d4f5f45a111"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Incident title",
      "defaultValue": "Incident: New database write failure"
    },
    {
      "name": "priority",
      "type": "string",
      "description": "Incident priority",
      "defaultValue": "P3"
    },
    {
      "name": "description",
      "type": "string",
      "description": "Incident description",
      "defaultValue": ""
    },
    {
      "name": "labels",
      "type": "dictionary",
      "description": "Incident labels",
      "defaultValue": {}
    },
    {
      "name": "labels.*",
      "type": "string",
      "description": "Incident label values"
    },
    {
      "name": "incident_link",
      "type": "string",
      "description": "Incident link",
      "defaultValue": ""
    },
    {
      "name": "source_alert_instance_uid",
      "type": "string",
      "description": "Source alert instance UID for traceability",
      "defaultValue": ""
    }
  ],
  "sample": {
    "username": "1stLine by example",
    "attachments": [
      {
        "title": "Incident: Database write failures",
        "title_link": "https://1stline.example.test/incidents/incident-9f1b9a2e-3d42-4c1e-8e15-4d4f5f45a111",
        "text": "*Event:* created\n*Priority:* P1\n*Description:* Database writes are timing out on the primary cluster.\n*Labels:* infra=example, env=prod",
        "fallback": "Incident: Database write failures",
        "footer": "1stLine incident",
        "color": "#D63232",
        "ts": 1766778140
      }
    ]
  },
  "patterns": [
    {
      "name": "incident_uid",
      "type": "string",
      "description": "Internal incident UID used as the fingerprint source",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "i",
          "pattern": "^https?://[^\\s]+/incidents/(?<extract>[A-Za-z0-9][A-Za-z0-9-]{2,127})$"
        }
      },
      "sourceField": "attachments.0.title_link"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Incident title",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "pattern": "^(?<extract>.+)$"
        }
      },
      "sourceField": "attachments.0.title"
    },
    {
      "name": "priority",
      "type": "string",
      "description": "Incident priority",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "m",
          "pattern": "^\\*Priority:\\*\\s*(?<extract>P[1-5])$"
        }
      },
      "sourceField": "attachments.0.text"
    },
    {
      "name": "description",
      "type": "string",
      "description": "Incident description",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "m",
          "pattern": "^\\*Description:\\*\\s*(?<extract>.*)$"
        }
      },
      "sourceField": "attachments.0.text"
    },
    {
      "name": "labels",
      "type": "dictionary",
      "dictionary": {
        "type": "string",
        "sourcePattern": {
          "type": "keyPairRegex",
          "config": {
            "flags": "m",
            "extractAll": true,
            "trimValues": true,
            "pattern": "(?<key>[^=,\\s]+)\\s*=\\s*(?<value>[^,\\n]+)"
          }
        }
      },
      "description": "Incident labels",
      "hasChildren": true,
      "sourceField": "attachments.0.text",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "m",
          "pattern": "^\\*Labels:\\*\\s*(?<extract>[^\\n]*)$"
        }
      },
      "saveIntermediate": false,
      "fallbacks": [
        {
          "type": "dictionary",
          "description": "Fallback labels parsed from incident labels passthrough JSON",
          "hasChildren": true,
          "sourceField": "incident_labels_json",
          "sourcePattern": {
            "type": "split",
            "config": {
              "delimiter": "__NO_SPLIT_SENTINEL__"
            }
          },
          "dictionary": {
            "type": "string",
            "sourcePattern": {
              "type": "json_extract",
              "config": {
                "jsonPath": "$.*",
                "parseAsJson": true
              }
            }
          },
          "saveIntermediate": false
        }
      ]
    },
    {
      "name": "incident_link",
      "type": "string",
      "description": "Incident link",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "pattern": "^(?<extract>https?://[^\\s]+/incidents/[A-Za-z0-9][A-Za-z0-9-]{2,127})$"
        }
      },
      "sourceField": "attachments.0.title_link"
    },
    {
      "name": "source_alert_instance_uid",
      "type": "string",
      "description": "Source alert instance UID for traceability",
      "sourcePattern": {
        "type": "regex",
        "config": {
          "flags": "im",
          "pattern": "^\\*Source alert:\\*\\s*(?<extract>[A-Za-z0-9][A-Za-z0-9-]{2,127})$"
        }
      },
      "sourceField": "attachments.0.text"
    }
  ],
  "resolution_patterns": [],
  "resolution_mapping": null,
  "ack_mapping": null,
  "allow_guest_ack": false,
  "incident_lifecycle_mapping": {
    "created": {
      "title": "title",
      "description": "description",
      "incident_link": "incident_link",
      "overrides": {
        "attachments[0].color": "#D63232",
        "attachments[0].fallback": "${incident.event.type}: ${incident.title}",
        "incident_labels_json": "${labels}",
        "priority": "${priority}"
      },
      "send_alert": true,
      "register_alert": true
    },
    "closed": {
      "title": "title",
      "description": "description",
      "incident_link": "incident_link",
      "overrides": {
        "attachments[0].color": "#808080",
        "attachments[0].fallback": "${incident.event.type}: ${incident.title}"
      },
      "send_alert": true,
      "register_alert": false
    },
    "reopened": {
      "title": "title",
      "description": "description",
      "incident_link": "incident_link",
      "overrides": {
        "attachments[0].color": "#D63232",
        "attachments[0].fallback": "${incident.event.type}: ${incident.title}"
      },
      "send_alert": true,
      "register_alert": false
    },
    "resolved": {
      "title": "title",
      "description": "description",
      "incident_link": "incident_link",
      "overrides": {
        "attachments[0].color": "#33cc33",
        "attachments[0].fallback": "${incident.event.type}: ${incident.title}"
      },
      "send_alert": true,
      "register_alert": false
    }
  },
  "resolution_proxy_config": "none",
  "proxy_recurrent_alerts": false,
  "fingerprint_fields": [
    "incident_uid"
  ],
  "default_forward_to": null
}
